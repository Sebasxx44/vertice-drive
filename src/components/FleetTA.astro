---
import ActionHeaderTA from '@/components/ActionHeaderTA.astro';
import IconTA from '@/components/IconTA.astro';
import PhotoTA from '@/components/PhotoTA.astro';
import { vehicles } from '@/data/vehicles';
import { rates, formatMoney } from '@/data/rental';
const filters=[{id:'todos',label:'Todos los caminos'},{id:'urbano',label:'Urbano'},{id:'suv',label:'SUV'},{id:'deportivo',label:'Deportivo'}];
---
<section id="flota" class="fleet section-space" aria-labelledby="flota-title"><div class="section-heading-row"><ActionHeaderTA number="01" eyebrow="UNA FORMA DE IR CONTIGO" title="Elige cómo quieres llegar." id="flota-title"/><p>Hay un vehículo para cada plan.<br/>Y un plan que empieza al elegirlo.</p></div><div class="fleet-toolbar"><div class="filter-list" role="group" aria-label="Filtrar vehículos por categoría">{filters.map((filter)=><button type="button" data-filter={filter.id} aria-pressed={filter.id==='todos'}>{filter.label}</button>)}</div><p id="fleet-count" role="status">3 vehículos para explorar</p></div><div class="fleet-grid">{vehicles.map((vehicle,index)=><article class="vehicle-card" data-category={vehicle.category}><div class="vehicle-image"><PhotoTA name={vehicle.image} alt={vehicle.alt}/><span class="vehicle-tag">{vehicle.label}</span><span class="vehicle-index">0{index+1}</span></div><div class="vehicle-meta"><div><span class="eyebrow">{vehicle.category==='suv'?'SUV':vehicle.category.toUpperCase()}</span><h3>{vehicle.name}</h3></div><span class="vehicle-rate">{formatMoney(rates[vehicle.id])}<small>/ día · COP</small></span></div><p class="vehicle-subtitle">{vehicle.subtitle}</p><div class="vehicle-specs"><span><IconTA name="people" size={15}/>{vehicle.seats} pasajeros</span><span><IconTA name="bag" size={14}/>{vehicle.luggage} maletas</span><span>Automático</span></div><button class="vehicle-choose" type="button" data-vehicle={vehicle.id}>Elegir este vehículo <IconTA size={17}/></button></article>)}</div><p class="concept-line">Flota y tarifas ilustrativas. Las fotografías representan categorías de una experiencia conceptual.</p></section>
